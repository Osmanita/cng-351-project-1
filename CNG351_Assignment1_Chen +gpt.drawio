        <mxCell id="text_0" value="Use Case 3A - Companies, employees and offices" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=42;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="40" width="2872" height="65" as="geometry" />
        </mxCell>
        <mxCell id="text_1" value="Chen ERD | Company.EmployeeCount* is a stored, automatically maintained derived value." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="115" width="2872" height="65" as="geometry" />
        </mxCell>
        <mxCell id="text_2" value="A company's representative must be one of its own current employees. Represents is therefore a subset of WorksFor." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="2625.0" width="2872" height="55" as="geometry" />
        </mxCell>
        <mxCell id="text_3" value="Every company currently operating in KALTEV needs at least one ongoing rental. Rental periods for the same office must not overlap." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="2680.0" width="2872" height="55" as="geometry" />
        </mxCell>
        <mxCell id="text_4" value="Employee.Email is unique in addition to NationalID. EmployeeCount* is the stored count of current employees in WorksFor and is updated automatically." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="2735.0" width="2872" height="55" as="geometry" />
        </mxCell>
      <mxCell id="notes_heading" value="Notes" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=27;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="2570.0" width="2872" height="40" as="geometry" />
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
