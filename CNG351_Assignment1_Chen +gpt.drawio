        <mxCell id="text_0" value="Use Case 3C - Meeting rooms and investment" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=42;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="40" width="3825" height="65" as="geometry" />
        </mxCell>
        <mxCell id="text_1" value="Chen ERD | Company is the same entity as in View 3A; TotalInvestmentReceived is shown here." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="115" width="3825" height="65" as="geometry" />
        </mxCell>
        <mxCell id="text_2" value="Booking is identified by (RoomNumber, BookingDate, StartTime). Its partial key is (BookingDate, StartTime)." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="2146.0" width="3825" height="55" as="geometry" />
        </mxCell>
        <mxCell id="text_3" value="There are exactly ten MeetingRoom records. Each booking links one room to one company." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="2201.0" width="3825" height="55" as="geometry" />
        </mxCell>
        <mxCell id="text_4" value="Each investment is kept as a separate transaction. Totals sum Amount for either a company or an investor-company pair." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="2256.0" width="3825" height="55" as="geometry" />
        </mxCell>
      <mxCell id="notes_heading" value="Notes" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=27;fontStyle=1;" vertex="1" parent="1">
