        <mxCell id="text_0" value="Use Case 2A - Equipment and dormitory allocation" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=42;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="40" width="3740" height="65" as="geometry" />
        </mxCell>
        <mxCell id="text_1" value="Chen ERD | Allocation attributes belong to the Machine-Dormitory pair." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="115" width="3740" height="65" as="geometry" />
        </mxCell>
        <mxCell id="text_2" value="IsLeadingDorm is derived separately for each machine and is true exactly when UsageRank = 1." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="2470.6327652177038" width="3740" height="55" as="geometry" />
        </mxCell>
        <mxCell id="text_3" value="Capacity is composite, with MinLoad and MaxLoad as its components. SupportedPrograms is multivalued." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="2525.6327652177038" width="3740" height="55" as="geometry" />
        </mxCell>
      <mxCell id="notes_heading" value="Notes" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=27;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="2415.6327652177038" width="3740" height="40" as="geometry" />
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
