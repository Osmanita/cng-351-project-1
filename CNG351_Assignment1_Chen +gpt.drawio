        <mxCell id="edge_28" value="(1,1)" style="endArrow=none;startArrow=none;html=0;rounded=0;strokeColor=#17212b;strokeWidth=2.5;shape=link;width=8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Arial;fontSize=27;fontStyle=1;fontColor=#17212b;labelBackgroundColor=none;" edge="1" parent="1" source="e_JokerUse" target="n30">
          <mxGeometry x="-0.72" relative="1" as="geometry">
            <mxPoint x="0" y="-30" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_29" value="(0,N)" style="endArrow=none;startArrow=none;html=0;rounded=0;strokeColor=#17212b;strokeWidth=2.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Arial;fontSize=27;fontStyle=1;fontColor=#17212b;labelBackgroundColor=none;" edge="1" parent="1" source="e_JokerType" target="n30">
          <mxGeometry x="-0.72" relative="1" as="geometry">
            <mxPoint x="0" y="-26" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="text_0" value="Use Case 1B - Questions, answers and jokers" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=42;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="40" width="3788" height="65" as="geometry" />
        </mxCell>
        <mxCell id="text_1" value="Chen ERD | Contestant is the same entity as in View 1A. Dashed underlines denote partial keys." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="115" width="3788" height="65" as="geometry" />
        </mxCell>
        <mxCell id="text_2" value="AttemptNo follows the question order within a game. The full keys are (ContestantID, AttemptNo) for QuestionAttempt and (ContestantID, UseNo) for JokerUse." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="2146.0" width="3788" height="55" as="geometry" />
        </mxCell>
        <mxCell id="text_3" value="UsedFor links a joker use to an attempt by the same contestant. We keep IsCorrect as a stored value and check it against GivenAnswer = Question.CorrectChoice." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="2201.0" width="3788" height="55" as="geometry" />
        </mxCell>
        <mxCell id="text_4" value="JokerType.TypeName is one of the three listed options: Fifty-Fifty, Phone a Friend or Ask the Audience." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="2256.0" width="3788" height="55" as="geometry" />
        </mxCell>
      <mxCell id="notes_heading" value="Notes" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=27;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="2091.0" width="3788" height="40" as="geometry" />
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
