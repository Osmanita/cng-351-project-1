        <mxCell id="text_0" value="Use Case 2C - Usage sessions and maintenance" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=42;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="40" width="3340" height="65" as="geometry" />
        </mxCell>
        <mxCell id="text_1" value="Chen ERD | Machine and Dormitory are references to View 2A. A usage session is weak under its machine." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="115" width="3340" height="65" as="geometry" />
        </mxCell>
        <mxCell id="text_2" value="UsageSession has the full key (MachineID, SessionNo). Duration is derived from StartTime and EndTime once both are available." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="2146.0" width="3340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="text_3" value="Completed and interrupted sessions must identify a dormitory. The machine must be allocated to that dormitory at the time of use." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="2201.0" width="3340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="text_4" value="A new maintenance agreement gets its own ContractID, even when the supplier and machine are the same." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="2256.0" width="3340" height="55" as="geometry" />
        </mxCell>
      <mxCell id="notes_heading" value="Notes" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=27;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="2091.0" width="3340" height="40" as="geometry" />
        </mxCell>
        </root>
    </mxGraphModel>
  </diagram>
