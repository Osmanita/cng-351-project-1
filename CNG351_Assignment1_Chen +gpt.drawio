        </mxCell>
        <mxCell id="text_1" value="Chen ERD | Dormitory is the same entity as in View 2A. Each separate stay has its own StayID." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="115" width="2470" height="65" as="geometry" />
        </mxCell>
        <mxCell id="text_2" value="Student.Username is unique on its own, in addition to StudentID. Student.Age is stored because no birth date is given." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="2127.0" width="2470" height="55" as="geometry" />
        </mxCell>
        <mxCell id="text_3" value="Each student has one open Stay with EndDate = NULL, and its dormitory must match CurrentlyIn. A return to the same dormitory gets a new StayID." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="2182.0" width="2470" height="55" as="geometry" />
        </mxCell>
