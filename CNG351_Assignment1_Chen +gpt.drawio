        <mxCell id="text_0" value="Use Case 1A - Production and participation" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=42;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="40" width="2773" height="65" as="geometry" />
        </mxCell>
        <mxCell id="text_1" value="Chen ERD | Entity attributes continue in View 1B where marked. All relationships are binary." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="115" width="2773" height="65" as="geometry" />
        </mxCell>
        <mxCell id="text_2" value="Contestant.Age is the number of completed years since DateOfBirth. Host.Email is unique in addition to HostID." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="2467.0" width="2773" height="55" as="geometry" />
        </mxCell>
        <mxCell id="text_3" value="One Contestant record is kept for each person. It belongs to one episode, so a person can take part in the show only once." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="100" y="2522.0" width="2773" height="55" as="geometry" />
        </mxCell>
