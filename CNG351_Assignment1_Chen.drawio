eometry relative="1" as="geometry"><Array as="points"><mxPoint x="2408.0" y="762.0" /><mxPoint x="2408.0" y="750" /><mxPoint x="2400" y="750" /><mxPoint x="2400" y="1125" /><mxPoint x="2325" y="1125" /><mxPoint x="2330.0" y="1125" /><mxPoint x="2330.0" y="1121.0" /></Array></mxGeometry></mxCell><mxCell id="text_0" value="Use Case 1A - Production and participation" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=42;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="40" width="2773" height="65" as="geometry" /></mxCell><mxCell id="text_1" value="Chen ERD | Entity attributes continue in View 1B where marked. All relationships are binary." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1"><mxGeometry x="100" y="115" width="2773" height="65" as="geometry" /></mxCell><mxCell id="text_2" value="Age = completed years since DateOfBirth. Host.Email is an alternate unique key." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1"><mxGeometry x="100" y="2412.0" width="2773" height="55" as="geometry" /></mxCell><mxCell id="text_3" value="Contestant has one record per person and belongs to exactly one episode; therefore a person participates once." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1"><mxGeometry x="100" y="2467.0" width="2773" height="55" as="geometry" /></mxCell><mxCell id="text_4" value="(0,10)" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamil