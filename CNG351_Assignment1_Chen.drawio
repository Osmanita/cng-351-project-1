y=Arial;fontSize=25;" vertex="1" parent="1"><mxGeometry x="100" y="2625.0" width="2872" height="55" as="geometry" /></mxCell><mxCell id="text_4" value="Employee.Email is an alternate unique key. EmployeeCount* = count of current employees in WorksFor." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1"><mxGeometry x="100" y="2680.0" width="2872" height="55" as="geometry" /></mxCell><mxCell id="text_5" value="(1,1)" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2121.8194872372596" y="1042.0" width="150" height="50" as="geometry" /></mxCell><mxCell id="text_6" value="(1,N)" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="811.8194872372594" y="1008.4000000000001" width="150" height="50" as="geometry" /></mxCell><mxCell id="text_7" value="(0,1)" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2476.8194872372596" y="909.0" width="150" height="50" as="geometry" /></mxCell><mxCell id="text_8" value="(1,1)" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="676.8194872372594" y="909.0" width="150" height="50" as="geometry" /></mxCell><mxCell id="text_9" value="(1,N)" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=no