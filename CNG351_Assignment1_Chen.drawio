e room and one company." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1"><mxGeometry x="100" y="2146.0" width="3825" height="55" as="geometry" /></mxCell><mxCell id="text_4" value="Investment totals are sums of Amount, by company or by investor-company pair. Repeated investments remain distinct." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1"><mxGeometry x="100" y="2201.0" width="3825" height="55" as="geometry" /></mxCell><mxCell id="text_5" value="(0,N)" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="807.0" y="563.0" width="150" height="50" as="geometry" /></mxCell><mxCell id="text_6" value="(1,1)" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1710.0" y="563.0" width="150" height="50" as="geometry" /></mxCell><mxCell id="text_7" value="(1,1)" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2200.0" y="563.0" width="150" height="50" as="geometry" /></mxCell><mxCell id="text_8" value="(0,N)" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=27;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3110.0" y="563.0" width="150" height="50" as="geometry" /></mxCell><mxCell id="text_9" valu