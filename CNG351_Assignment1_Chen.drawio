html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=42;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="40" width="3340" height="65" as="geometry" /></mxCell><mxCell id="text_1" value="Chen ERD | Machine and Dormitory are references to View 2A. A usage session is weak under its machine." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1"><mxGeometry x="100" y="115" width="3340" height="65" as="geometry" /></mxCell><mxCell id="text_2" value="Full session key: (MachineID, SessionNo). Duration is derived from StartTime and EndTime." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1"><mxGeometry x="100" y="2091.0" width="3340" height="55" as="geometry" /></mxCell><mxCell id="text_3" value="Completed/interrupted sessions require a dormitory, and the machine must be allocated to that dormitory." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1"><mxGeometry x="100" y="2146.0" width="3340" height="55" as="geometry" /></mxCell><mxCell id="text_4" value="A ContractID allows several contracts for the same supplier-machine pair across time." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1"><mxGeometry x="100" y="2201.0" width="3340" height="55" as="geometry" /></mxCell><mxCell id="text_5" value="(0,N)" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor