><mxPoint x="510.0" y="1125" /><mxPoint x="510.0" y="1121.0" /></Array></mxGeometry></mxCell><mxCell id="text_0" value="Use Case 3B - Projects, deliverables and interns" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=42;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="40" width="3760" height="65" as="geometry" /></mxCell><mxCell id="text_1" value="Chen ERD | Company and Employee refer to View 3A. Every project manager must also work on that project." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1"><mxGeometry x="100" y="115" width="3760" height="65" as="geometry" /></mxCell><mxCell id="text_2" value="Full deliverable key: (ProjectCode, DeliverableNo). Numbering D1, D2, ... restarts within each project." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1"><mxGeometry x="100" y="2412.0" width="3760" height="55" as="geometry" /></mxCell><mxCell id="text_3" value="Manages is a subset of WorksOn. Project workers belong to the company that runs the project." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1"><mxGeometry x="100" y="2467.0" width="3760" height="55" as="geometry" /></mxCell><mxCell id="text_4" value="The supervisor must work for the intern's company. Only current internships are retained." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=none;fontColor=#17212b;fontFamily=Arial;fontSize=25;" vertex="1" parent="1"><mxGeometry x="100" y="2522.0" width="3760" height="5